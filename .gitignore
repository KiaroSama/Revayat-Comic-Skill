# --- Local-only agent / tooling state ---
/.ai/
/.agents/
/.claude/
/.kiro/
/.codex/
/.cursor/
/.cline/
/CLAUDE.local.md
/graphify-out/
.ignoreme
**/.ignoreme

# --- Secrets and private notes ---
/secrets.md
/explain-AI.md
/reference.md
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
# Any project-local virtualenv, whatever it is called.
/.*-venv/
/.uv-cache/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Revayat Comic working directories and outputs ---
*_revayat-comic/
/work/
/out/

# Comic pages and archives are someone else's artwork. Never commit them; the
# test suite draws its own fixtures instead.
*.cbz
*.cbr
*.png
*.jpg
*.jpeg
*.webp
*.psd
!docs/**/*.png

# Model checkpoints pulled at first run (hundreds of MB, and separately
# licensed from this repository — see references/models-and-licences.md).
/models/
*.onnx
*.pt
*.pth
*.safetensors

# --- Fonts ---
# A Persian font is chosen at run time from the machine's own fonts. Vendoring
# one would ship a separately licensed binary from this GPL tree.
/fonts/

# --- OS ---
.DS_Store
Thumbs.db

# Hook Maker: local/private files (auto-managed)
/CLAUDE.md
/AGENTS.md
/.env
/.env.*
!/.env.example
!/.env.sample
!/.env.template
!/.env.dist

# Deliberate, narrow exception to the two patterns above.
#
# In an ordinary project /AGENTS.md and /CLAUDE.md are private assistant
# configuration and must stay local. This repository is an agent skill: those
# two files ARE the deliverable's agent-facing documentation, read from the
# published repo by Codex, Cursor and Claude Code. Both were written as public
# docs and contain no secrets, no local-only paths and no private tooling
# references.
#
# The patterns above are kept intact, so any other private assistant file added
# later is still ignored by default. Only these two exact files are published.
!/AGENTS.md
!/CLAUDE.md
